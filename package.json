{
	"private": true,
	"devDependencies": {
		"@_tw/themejson": "^0.1.2",
		"@angular-eslint/template-parser": "^16.2.0",
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@tailwindcss/forms": "^0.5.6",
		"@tailwindcss/line-clamp": "^0.4.4",
		"@tailwindcss/typography": "^0.5.10",
		"@wordpress/eslint-plugin": "^17.1.0",
		"archiver": "^6.0.1",
		"babel-loader": "^9.1.3",
		"cross-env": "^7.0.3",
		"css-loader": "^6.8.1",
		"element-closest-polyfill": "^1.0.6",
		"esbuild": "^0.19.5",
		"eslint-plugin-php-markup": "^6.0.0",
		"eslint-plugin-tailwindcss": "^3.13.0",
		"glob": "^10.3.10",
		"imagemin": "^8.0.1",
		"imagemin-svgo": "^10.0.1",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.4.31",
		"postcss-import-ext-glob": "^2.1.1",
		"postcss-scss": "^4.0.9",
		"postcss-simple-vars": "^7.0.1",
		"prettier": "^3.0.3",
		"prettier-plugin-tailwindcss": "^0.5.6",
		"rimraf": "^5.0.5",
		"style-loader": "^3.3.3",
		"svg-classlist-polyfill": "^1.1.0",
		"svgSprite": "^1.2.0",
		"svgstore-cli": "^2.0.1",
		"tailwindcss": "^3.3.5",
		"tailwindcss-convert-px-to-rem": "^1.0.4",
		"webpack": "^5.89.0",
		"webpack-cli": "^5.1.4"
	},
	"scripts": {
		"development:rimraf": "rimraf dist",
		"development:imageminsvgo": "node imagemin-svgo.js",
		"development:prebuildsprite": "npm run development:imageminsvgo",
		"development:buildsprite": "svgstore -o ./theme/assets/svg/main.svg ./svg-sprites/*.svg --inline",
		"development:tailwind:frontend": "npx tailwindcss --postcss -i ./tailwind/tailwind.css -c ./tailwind/tailwind.config.js -o ./theme/style.css",
		"development:tailwind:editor": "cross-env _TW_TARGET=editor npx tailwindcss --postcss -i ./tailwind/tailwind.css -c ./tailwind/tailwind.config.js -o ./theme/style-editor.css",
		"development:tailwind:wceditor": "cross-env _TW_TARGET=editor npx tailwindcss --postcss -i ./tailwind/wc-editor.css -c ./tailwind/tailwind.config.js -o ./theme/wc-editor.css",
		"development:webpack": "npx webpack --config webpack.config.js",
		"development:esbuild": "npx esbuild ./javascript/wc-admin.js --target=esnext --external:jquery --bundle --outfile=./theme/js/wc-admin-scripts.min.js",
		"development": "run-p development:**",
		"dev": "npm run development",
		"watch:tailwind:frontend": "npm run development:tailwind:frontend -- --watch",
		"watch:tailwind:editor": "npm run development:tailwind:editor -- --watch",
		"watch:tailwind:wceditor": "npm run development:tailwind:wceditor -- --watch",
		"watch:webpack": "npm run development:webpack -- --watch",
		"watch:esbuild": "npm run development:esbuild -- --watch",
		"watch": "run-p watch:**",
		"watch:browser-sync": "browser-sync start --proxy \"http://prestige-rooms.local\" --files \"theme\" --no-notify --no-inject-changes",
		"lint:eslint": "npx eslint theme/",
		"lint:prettier": "npx prettier --check tailwind/**/*.css",
		"lint": "run-p lint:*",
		"lint-fix:eslint": "npx eslint theme/ --fix",
		"lint-fix:prettier": "npx prettier --write tailwind/**/*.css",
		"lint-fix": "run-p lint-fix:*",
		"production:tailwind:frontend": "cross-env NODE_ENV=production npm run development:tailwind:frontend -- --minify",
		"production:tailwind:editor": "cross-env NODE_ENV=production npm run development:tailwind:editor -- --minify",
		"production:tailwind:wceditor": "cross-env NODE_ENV=production npm run development:tailwind:wceditor -- --minify",
		"production:webpack": "npx webpack --config webpack-prod.config.js",
		"production:esbuild": "npm run development:esbuild -- --minify",
		"production": "run-p production:**",
		"prod": "npm run production",
		"zip": "node node_scripts/zip.js ap-wp-theme-tw",
		"bundle": "run-s production zip"
	},
	"dependencies": {
		"@alpinejs/anchor": "^3.13.2",
		"@alpinejs/persist": "^3.13.2",
		"@alpinejs/resize": "^3.14.1",
		"alpinejs": "^3.13.2",
		"alpinejs-breakpoints": "^2.1.1",
		"browser-sync": "^2.29.3",
		"gsap": "^3.12.2",
		"hoverintent": "^2.2.1",
		"imagesloaded": "^5.0.0",
		"js-datepicker": "^5.18.3",
		"photoswipe": "5.4.2",
		"plyr": "^3.7.8",
		"select2": "^4.1.0-rc.0",
		"swiper": "11.0.3",
		"vanilla-lazyload": "^17.8.5",
		"whatwg-fetch": "^3.6.19"
	}
}
